# Local teaching runtime. Synthetic mode needs no provider credentials.
API_HOST=127.0.0.1
API_PORT=3100
WEB_PORT=5173
WEB_ORIGIN=http://127.0.0.1:5173
DATA_MODE=synthetic
# Explicit live-provider opt-in; default tests remain synthetic.
YAHOO_ENABLED=false
YAHOO_REQUEST_TIMEOUT_MS=10000
YAHOO_MAX_CONCURRENCY=2
# YahooFinance v4 does not require a Yahoo API key. Never invent one.

# Part V live desk (ADR 0005). demo = synthetic fixtures; live = Yahoo polling.
MARKET_DATA_MODE=demo
# Refresh cadence: eod | 15m | 5m | 1m
LIVE_REFRESH=eod
# Comma-separated Yahoo symbols polled in addition to portfolio holdings.
LIVE_WATCHLIST=SPY,AAPL,MSFT
# Benchmark for risk and performance. Default: SPY live, the synthetic ETF ATLS in demo.
# LIVE_BENCHMARK=SPY
LIVE_MAX_REQUESTS_PER_MINUTE=30

# Default: .data/portfolio-atlas.sqlite. Set :memory: only for an ephemeral lesson.
# DATABASE_PATH=:memory:

# Optional governed workspace: run npm run auth:provision, then set an absolute path.
# AUTH_CONFIG_PATH=C:/path/to/repository/.data/access/policy.json
# Loopback HTTP development only. HTTPS deployments must use true.
AUTH_SECURE_COOKIE=false
